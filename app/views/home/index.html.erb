<div class="container">
  <p id="notice"><%= notice %></p>
  <h1>WolfEvents Portal</h1>
  <div class="logged-in-info">
    <% if current_user %>
      Logged in as <%= current_user.name %>.
      <%= link_to "Logout", logout_path %>
    <% else %>
      <%= link_to "Signup", signup_path %> or
      <%= link_to "Login", login_path %>
    <% end %>
  </div>

  <% if current_user %>
    <div class="link-section">
      <%= link_to "Edit/View Profile", profile_path %>
    </div>
    <% if is_admin %>
      <div class="link-section">
        <%= link_to "Manage Attendees", attendees_path %>
      </div>
    <% end %>
    <div class="link-section">
      <% if is_admin %>
        <%= link_to "Manage Events", events_path %>
      <% else %>
        <%= link_to "My Events", events_path(:Attendee_id => current_user.id) %>
      <% end %>
    </div>
    <div class="link-section">
      <% if is_admin %>
        <%= link_to "Manage Event tickets", event_tickets_path %>
      <% else %>
        <%= link_to "My Event Tickets", event_tickets_path(:Attendee_id => current_user.id) %>
      <% end %>
    </div>
    <% if is_admin %>
      <div class="link-section">
        <%= link_to "Manage Rooms", rooms_path %>
      </div>
      <div class="link-section">
        <%= link_to "Search Attendees for an Event", admin_search_path %>
      </div>
    <% end %>
    <div class="link-section">
      <%= link_to "My Booking History" ,booking_history_path%>
    </div>
    <div class="link-section">
      <%= link_to "View All Reviews", reviews_path %>
    </div>
    <div class="link-section">
      <%= link_to "My Reviews", reviews_path(attendee_id: current_user.id) %>
    </div>

  <% end %>
</div>