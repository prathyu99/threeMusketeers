<p style="color: green"><%= notice %></p>

<h1>Room Details</h1>

<table>
  <tr>
    <th>Room Location:</th>
    <td><%= @room.Room_location %></td>
  </tr>
  <tr>
    <th>Room Capacity:</th>
    <td><%= @room.Room_capacity %></td>
  </tr>
</table>

<div>
  <br>
  <%= link_to "Edit this room", edit_room_path(@room), class: 'btn btn-warning' %>
  <br>
  <%= link_to "Back to rooms", rooms_path, class: 'btn btn-info' %>
  <%= button_to "Destroy this room", @room, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger' %>
</div>
