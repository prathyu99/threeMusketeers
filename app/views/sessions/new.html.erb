<p id="alert"><%= alert %></p>
<h1>Login</h1>
<%= form_tag sessions_path do |form| %>
  <div class="field">
    <%= label_tag :email_address %>
    <%= text_field_tag :email_address, nil, required: true, type: 'email', placeholder: 'Enter your email' %>

  </div>
  <br>

  <div class="field">
    <%= label_tag :password %>
    <%= password_field_tag :password, nil, required: true, minlength: 6, placeholder: 'Enter your password' %>
  </div>

  <div class="actions">
    <%= submit_tag "Login", data: { disable_with: "Logging in..." } %>
  </div>
<% end %>