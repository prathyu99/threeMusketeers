<h1>Editing review</h1>

<% if @review.errors.any? %>
  <div style="color: red">
    <h2><%= pluralize(@review.errors.count, "error") %> prohibited this review from being saved:</h2>

    <ul>
      <% @review.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(model: @review, local: true) do |form| %>
  <%= form.hidden_field :Attendee_id %>
  <%= form.hidden_field :Event_id %>

  <div>
    <%= form.label :rating, 'Rating', style: "display: block" %>
    <%= form.select :rating, options_for_select((1..5).map { |number| [number, number] }, @review.rating), {}, { required: true } %>
  </div>

  <div>
    <%= form.label :feedback, 'Feedback', style: "display: block" %>
    <%= form.text_area :feedback, required: true %>
  </div>

  <div>
    <%= form.submit 'Update Review' %>
  </div>
<% end %>

<br>

<div>
  <%= link_to 'Show this review', @review %> |
  <%= link_to 'Back to reviews', reviews_path %>
</div>
